#!/usr/bin/env bash

## Build SpecStack frontend assets.
##
## Usage: theme [--local, -l]
## Options:
##   --local, -l  Run pnpm install and build on the host using .nvmrc.

set -euo pipefail

usage() {
  sed -n '3,7p' "$0" | sed 's/^## \{0,1\}//'
}

for arg in "$@"; do
  shift
  case "$arg" in
    --help) set -- "$@" "-h" ;;
    --local) set -- "$@" "-l" ;;
    *) set -- "$@" "$arg" ;;
  esac
done

LOCAL_MODE="false"

while getopts "hl" opt; do
  case "$opt" in
    h)
      usage
      exit 0
      ;;
    l) LOCAL_MODE="true" ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [ "$LOCAL_MODE" = "true" ]; then
  ddev theme-local
  exit 0
fi

cd "$DDEV_APPROOT"

echo "Installing SpecStack frontend dependencies in DDEV..."
ddev exec "CI=1 pnpm install --frozen-lockfile"

echo "Building SpecStack frontend assets in DDEV..."
ddev exec "pnpm build"
