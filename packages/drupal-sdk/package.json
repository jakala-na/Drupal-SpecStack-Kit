{
  "name": "@specstack/drupal-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./openapi-clients/*": "./src/openapi-clients/*"
  },
  "scripts": {
    "lint": "pnpm oxlint:fix && pnpm oxfmt && pnpm ts-check",
    "lint:check": "pnpm oxlint && pnpm oxfmt:check && pnpm ts-check",
    "oxlint": "oxlint --config ../../.oxlintrc.json src --ignore-pattern \"src/openapi-clients/specstack/**\"",
    "oxlint:fix": "oxlint --fix --config ../../.oxlintrc.json src --ignore-pattern \"src/openapi-clients/specstack/**\"",
    "oxfmt": "oxfmt src '!src/openapi-clients/specstack/**'",
    "oxfmt:check": "oxfmt --check src '!src/openapi-clients/specstack/**'",
    "ts-check": "tsc --noEmit",
    "openapi-ts": "openapi-ts --file src/openapi-clients/specstack.openapi.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.86.0",
    "react": "19.1.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.82.1",
    "@specstack/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.9",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.26.0",
    "typescript": "^5.9",
    "zod": "^4.1.1"
  }
}
